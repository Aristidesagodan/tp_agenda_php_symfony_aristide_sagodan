{% extends 'base.html.twig' %}

{% block body %}

<h1>Ajouter un contact</h1>

{# ✔ On affiche les messages flash #}
{% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
{% endfor %}

{# ✔ On affiche le formulaire avec Bootstrap #}
<div class="container">
    {{ form_start(form) }}

    {# ✔ Chaque champ sera automatiquement affiché avec les erreurs éventuelles #}
    {{ form_row(form.nom) }}
    {{ form_row(form.prenom) }}
    {{ form_row(form.telephone) }}
    {{ form_row(form.adresse) }}
    {{ form_row(form.ville) }}
    {{ form_row(form.age) }}

    <button class="btn btn-primary">{{ form.save.vars.label }}</button>

    {{ form_end(form) }}
</div>

{% endblock %}
