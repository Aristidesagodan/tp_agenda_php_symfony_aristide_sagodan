{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<h1>Bienvenue sur la page d’accueil</h1>



<h1>Liste des contacts</h1>

<table class="table table-striped table-hover mt-4">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Téléphone</th>
            <th>Action</th>
            <th>Catégorie</th>

        </tr>
    </thead>

    <tbody>
        {# ✔ On boucle sur la liste $contacts envoyée depuis le controller #}
        {% for contact in contacts %}
        <tr>
            <td>{{ contact.id }}</td> 
            <td>{{ contact.nom }}</td> {# ✔ Affichage du nom #}
            <td>{{ contact.prenom }}</td> {# ✔ Affichage du prénom #}
            <td>{{ contact.telephone }}</td> {# ✔ Affichage du téléphone #}
            <td>{{ contact.category.title }}</td>
            <td>
            
             <a href="{{ path('contact_show', {'id': contact.id}) }}" class="btn btn-info">
                Afficher
            </a> 
            {% if app.user %}
        <a href="{{ path('contact_edit', { id: contact.id }) }}"
           class="btn btn-warning">
           Modifier
        </a>

        <a href="{{ path('contact_delete', { id: contact.id }) }}"
           class="btn btn-danger"
           onclick="return confirm('Confirmer la suppression ?')">
           Supprimer
        </a>
    {% endif %}

            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>



{% for contact in contacts %}
<tr>
    <td>{{ contact.id }}</td>
    <td>{{ contact.nom }}</td> {# ✔ Affichage du nom #}
    <td>{{ contact.prenom }}</td> {# ✔ Affichage du prénom #}
    <td>{{ contact.telephone }}</td> {# ✔ Affichage du téléphone #}
    <td>{{ contact.category.title }}</td>
    <td>
         {# ✔ Lien pour voir la fiche d’un contact #}
        <a href="{{ path('contact_show', {'id': contact.id}) }}" class="btn btn-info">
            Afficher
        </a>
         {# ✔ Lien pour modifier le contact #}
        <a href="{{ path('contact_edit', {'id': contact.id}) }}" class="btn btn-warning">
            Modifier
        </a>
         {# ✔ Lien pour supprimer le contact #}
        <a href="{{ path('contact_delete', {'id': contact.id}) }}" class="btn btn-danger">
            Supprimer
        </a>

    
    </td>
</tr>
{% endfor %}

{% endblock %}

